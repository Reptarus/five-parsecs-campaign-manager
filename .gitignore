# Godot 4+ specific ignores
.godot/

# Godot-specific ignores
.import/
export.cfg
export_presets.cfg
*.translation

# Builds and exports
/android/
/builds/
/build/
/dist/
*.apk
*.idsig
*.pck
*.exe

# Project-local secrets (never commit)
.env.local
support_config.cfg
addons/talo/settings.cfg

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
*.tmp

# Native binaries — plugin libs, Steam SDK, export templates
*.dll
*.so
*.dylib
*.aar
*.framework
*.xcframework

# Large art assets (not source code)
Assets/BookImages/

# PSD extraction recovery cache (raw per-layer dumps; categorized copies live
# alongside in bg/, actors/, fx/, props/ and ARE committed)
assets/scenes/*/_raw/

# Third-party addons with large binary content
addons/curved_lines_2d/

# System/tool-specific ignores
.DS_Store
*~
*.blend1
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Project specific ignores
override.cfg
*.save
*.bak
node_modules

# Dev artifacts - prevent root clutter
/reports/
# NOTE: `/scripts/*` not `/scripts/`. Git cannot re-include a file whose PARENT
# DIRECTORY is excluded, so with `/scripts/` the negation below silently did
# nothing: the four existing lints only appeared to be covered by it because they
# were added before the rule existed, and .gitignore does not affect
# already-tracked files. Any NEW lint was silently dropped by `git add`.
# Excluding the directory CONTENTS instead lets the negation work.
/scripts/*
# ...but the lint suite is tracked CI tooling (wiring-audit + data-ownership guards)
!/scripts/lint_*.py
/tools/
/mcp-servers/
/screenshot/
package-lock.json
*.mdc

# Test output dumps
test_*_output.txt
test_results.txt
test_e2e_*.txt
test_full_run.txt
.mcp/

# Installers / tooling binaries (never commit)
*.msi
*.exe

# Sheet-calibration tool debug outputs (visualization only, not source of truth)
tools/_debug/

